--- !u!114 &2129109051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2129109049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ee71bae2b2ea2d4386dce41c6feac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialoguebox
  DialogueSegments:
  - Dialogue: That's.. A lot of cats.
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: Oh yes, I even recently added a new stray to my collection! Isnt that
      right, little mister pickle!! Ohh you're such a little darling!
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices: []
  - Dialogue: '     < The woman picks up a... thing.. From the floor and snuggles
      it affectionately. the thing seems to respond, so at least it''s alive. Maybe
      it would be better if it wasn''t. >'
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  - Dialogue: Are you sure thats a cat?
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: It looks like one?
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices: []
  - Dialogue: Right... well, do you happen to know a good way to the tower?
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: "Tower... Tower...... oh right! Aha, I almost forgot about that thing!
      You know, back in the day, my wife used to work there! Oh, I haven't seen her
      in so long.. I hope she\u2019s alright. I'm sure she'll come back one of these
      days. Now.. What was your question again?"
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices:
    - ChoiceText: How do I get to the tower?
      NextSegmentIndex: 7
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - ChoiceText: When did you last see your wife?
      NextSegmentIndex: 9
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - ChoiceText: Nevermind, goodbybe..
      NextSegmentIndex: 11
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
  - Dialogue: "The what? Oh, yes mister pickle, I\u2019ll feed you soon, okay? No
      more meowing!"
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices: []
  - Dialogue: ugh..
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices:
    - ChoiceText: When did you last see your wife?
      NextSegmentIndex: 9
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - ChoiceText: Goodbye
      NextSegmentIndex: 11
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
  - Dialogue: "Who? I haven\u2019t seen any wives around except for that horrible
      woman that lives on baker street.. always so unfriendly, and yelling about
      this and that. "
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices: []
  - Dialogue: "And you didn\u2019t hear this from me!... But you\u2019re hearing
      this from me. Those two are up to no good. I think they\u2019re planning to
      do something awful to their poor neighbor\u2026 "
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices:
    - ChoiceText: How do I get to the tower?
      NextSegmentIndex: 7
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - ChoiceText: Goodbye.
      NextSegmentIndex: 11
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
  - Dialogue: Wait!! Don't go just yet! Here, take this.
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices: []
  - Dialogue: '     < She hands you a mug of milk. It''s uncomfortably lukewarm.
      >'
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  - Dialogue: You never know when you might meet another poor cold lonely stray.
      There's so many around these days.. If you see one, give them this glass of
      milk and let them know old granny smith lives just down the street, and will
      gladly take them in!
    Speaker: {fileID: 11400000, guid: bbbd40e267086974794142ec7dc64802, type: 2}
    Choices: []
  target: {fileID: 163930005}
  DialoguePanel: {fileID: 1669151250}
  SpeakerFaceDisplay: {fileID: 215539810}
  DialogueBoxBorder: {fileID: 915150511}
  DialogueBoxInner: {fileID: 115567569}
