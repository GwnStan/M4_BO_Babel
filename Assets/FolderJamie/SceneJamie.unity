  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ee71bae2b2ea2d4386dce41c6feac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialoguebox
  DialogueSegments:
  - Dialogue: 'Hello? Are you the smith? '
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: "Who's there?? Is that you, Stubb? You haven't come here to kill me,
      have you?? I can see that knife you're holding! You\u2019re not fooling me!"
    Speaker: {fileID: 11400000, guid: addca2bc8cfc54c4cb98deaa536e77f8, type: 2}
    Choices: []
  - Dialogue: '     < The smith jumps from his chair and starts walking back into
      a corner, holding his hand out as if to keep a wild animal at bay. > '
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  - Dialogue: No, no, i'm just a traveler. See? i'm harmless-
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: 'SHUT UP!! Shut up, shut up! You''re all the same! You backstabbers!
      Non-believers! '
    Speaker: {fileID: 11400000, guid: addca2bc8cfc54c4cb98deaa536e77f8, type: 2}
    Choices: []
  - Dialogue: '     < His head snaps towards the window. There''s no one there. >'
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  - Dialogue: I see you there!! You're not sneaky, Flask! I always knew you traitors
      would come back for my head. Get OUT of my house before I grab that halbert
      from the wall and slay you all!
    Speaker: {fileID: 11400000, guid: addca2bc8cfc54c4cb98deaa536e77f8, type: 2}
    Choices: []
  - Dialogue: '    < You can''t see any halberds around. You decide to leave before
      it gets dangerous. As you leave the house, you hear the smith still yelling
      to no-one. > '
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  target: {fileID: 1259934964}
  DialoguePanel: {fileID: 1669151250}
