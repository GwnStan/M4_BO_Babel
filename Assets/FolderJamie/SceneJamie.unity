--- !u!114 &387448684
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 387448682}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ee71bae2b2ea2d4386dce41c6feac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialoguebox
  DialogueSegments:
  - Dialogue: Stranger, over here...
    Speaker: {fileID: 11400000, guid: c11521e10e6272243b724d43641a7f60, type: 2}
    Choices: []
  - Dialogue: '     < You hear a voice speak, but you can hardly make out where it
      came from. Suddenly, you see movement close to the floor out of the corner
      of your eye. It looks like a hand, making a beckoning gesture. > '
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  - Dialogue: '     < As you approach the mangled mass of white and bone, you make
      the connection that it might have been a human, once. > '
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  - Dialogue: Hello? Are you, uhm.. alive? Can I help you?
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: "     < As it speaks, you can\u2019t make out where the voice is coming
      from. > "
    Speaker: {fileID: 11400000, guid: a47631f9fe0cece4ab84178e5649e0ae, type: 2}
    Choices: []
  - Dialogue: "No, that\u2019s alright. I\u2019m beyond help, and have been for a
      long time. But perhaps I can help you? You seem to be on your way to the tower.
      I understand from passing figures before you that the gates on the bridges
      have been closed."
    Speaker: {fileID: 11400000, guid: 3f2d4127447802d408e76e11b112be97, type: 2}
    Choices: []
  - Dialogue: 'They are. Is there a way back up to the tower from here? '
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: There is, but humor me with a conversation, first? I would like to
      hear your story, stranger.
    Speaker: {fileID: 11400000, guid: 3f2d4127447802d408e76e11b112be97, type: 2}
    Choices: []
  target: {fileID: 337554658}
  DialoguePanel: {fileID: 1669151250}
