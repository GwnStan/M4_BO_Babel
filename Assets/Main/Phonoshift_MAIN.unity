      propertyPath: DialogueSegments.Array.data[2].Dialogue
      value: '     < The smith jumps from his spot and starts walking back into a
        corner, holding his hand out as if to keep a wild animal at bay. > '
      objectReference: {fileID: 0}
    - target: {fileID: 3974145217418091169, guid: 49827dbfda6b3474eae02c0657321306, type: 3}
      propertyPath: DialogueSegments.Array.data[5].Dialogue
      value: '     < His head snaps towards the empty planes next to you. There''s
        no one there. >'
      objectReference: {fileID: 0}
    - target: {fileID: 3974145217418091169, guid: 49827dbfda6b3474eae02c0657321306, type: 3}
      propertyPath: DialogueSegments.Array.data[7].Dialogue
      value: '    < You can''t see any halberds around, and you''re not even inside.
        > '
      objectReference: {fileID: 0}
    - target: {fileID: 3974145217418091169, guid: 49827dbfda6b3474eae02c0657321306, type: 3}
      propertyPath: DialogueSegments.Array.data[8].Dialogue
      value: '    < As you leave the area, you hear the smith still yelling to no-one.
        > '
