      value: Where you're from
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[9].Choices.Array.data[1].ChoiceText
      value: Why you're here
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[9].Choices.Array.data[2].ChoiceText
      value: Why you're here
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[10].Choices.Array.data[0].ChoiceText
      value: Where you're from
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[10].Choices.Array.data[1].ChoiceText
      value: "What about the people who can\u2019t make it to the tower?"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[10].Choices.Array.data[2].ChoiceText
      value: "What about the people who don\u2019t want to ascend?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[11].Choices.Array.data[0].ChoiceText
      value: The whales are divine?
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[14].Choices.Array.data[0].ChoiceText
      value: "Can\u2019t you help me remove the blockade?"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[14].Choices.Array.data[1].ChoiceText
      value: And this is for my own good.. How?
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[14].Choices.Array.data[2].ChoiceText
      value: Goodbye.
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[15].Choices.Array.data[0].ChoiceText
      value: Why you're here
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[15].Choices.Array.data[1].ChoiceText
      value: "What about the people who don\u2019t want to ascend?"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[15].Choices.Array.data[2].ChoiceText
      value: "What about this \u201Cevil from the deep\u201D you mentioned?"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
