--- !u!114 &1679586253
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679586251}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ee71bae2b2ea2d4386dce41c6feac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialoguebox
  DialogueSegments:
  - Dialogue: Hey, I heard theres a sinkhole on the way to the tower, and that you
      might be capable of building something over it?
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: "Ugh, you\u2019re not the first to ask. Where\u2019d all these annoying
      passerby\u2019s come from?"
    Speaker: {fileID: 11400000, guid: 9e6be8df10068b84da1df42159d4aa60, type: 2}
    Choices: []
  - Dialogue: "Look man, I\u2019d loooove to help you out, but my axe has gone missing,
      and I can\u2019t really chop up wood without it."
    Speaker: {fileID: 11400000, guid: 9e6be8df10068b84da1df42159d4aa60, type: 2}
    Choices:
    - ChoiceText: I'll help you find it?
      NextSegmentIndex: 3
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
    - ChoiceText: Found it!
      NextSegmentIndex: 6
      Condition:
        Type: 1
        RequiredItem: {fileID: 11400000, guid: 8ad278441ef890b4b992143d94087d53, type: 2}
        RequiredQuest: {fileID: 11400000, guid: f8d0c31a84dd41341a78553493aa7125, type: 2}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 994729841}
            m_TargetAssemblyTypeName: ItemRemove, Assembly-CSharp
            m_MethodName: Remove
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 727316280}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
  - Dialogue: Where did you last see it?
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: I probably lost it somewhere near the sinkhole. I was there when it
      opened up.
    Speaker: {fileID: 11400000, guid: 9e6be8df10068b84da1df42159d4aa60, type: 2}
    Choices: []
  - Dialogue: I haven't gone near it since, cause I don't trust it to be stable.
    Speaker: {fileID: 11400000, guid: 9e6be8df10068b84da1df42159d4aa60, type: 2}
    Choices:
    - ChoiceText: I'll go look.
      NextSegmentIndex: -1
      Condition:
        Type: 0
        RequiredItem: {fileID: 0}
        RequiredQuest: {fileID: 0}
      onChoiceSelected:
        m_PersistentCalls:
          m_Calls: []
  - Dialogue: I found it! Now can you help with the bridge?
    Speaker: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    Choices: []
  - Dialogue: "Oh, you're... the sinkhole didn\u2019t collapse further?"
    Speaker: {fileID: 11400000, guid: 9e6be8df10068b84da1df42159d4aa60, type: 2}
    Choices: []
  - Dialogue: "Alright, alright. I\u2019ll build you something fast. You and that
      weird horse guy that\u2019s probably still waiting there."
    Speaker: {fileID: 11400000, guid: 9e6be8df10068b84da1df42159d4aa60, type: 2}
    Choices: []
  target: {fileID: 1679586252}
