      objectReference: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[19].Speaker
      value: 
      objectReference: {fileID: 11400000, guid: e6a7c7f1be968f54891ad2b593629930, type: 2}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[1].Dialogue
      value: Welcome, welcome! Please, feel free to take a moments rest, and allow
        me, The High Priest Ishmael, to congratulate you on nearly completing your
        journey
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[20].Speaker
      value: 
      objectReference: {fileID: 11400000, guid: e6a7c7f1be968f54891ad2b593629930, type: 2}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[21].Speaker
      value: 
      objectReference: {fileID: 11400000, guid: e6a7c7f1be968f54891ad2b593629930, type: 2}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[22].Speaker
