      propertyPath: DialogueSegments.Array.data[29].Choices.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[31].Choices.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[10].Choices.Array.data[0].ChoiceText
      value: The whales are divine?
      objectReference: {fileID: 0}
