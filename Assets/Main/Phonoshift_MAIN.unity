      propertyPath: DialogueSegments.Array.data[16].Speaker
      value: 
      objectReference: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[17].Speaker
      value: 
      objectReference: {fileID: 11400000, guid: f058b5915c349ff4eb72ec296a84bbc1, type: 2}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[18].Speaker
      value: 
      objectReference: {fileID: 11400000, guid: eaff7ea8a8cfb0e45b2ee58dbe2e539a, type: 2}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[1].Dialogue
      value: Hell if I know! Why should I be concerned with gettin to that building?
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[2].Dialogue
      value: " Um\u2026 don\u2019t you all want to climb the tower? Is there something
        keeping you here?"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[3].Dialogue
      value: The only thing keeping me here is my family.
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[4].Dialogue
      value: "uh.. family? There\u2019s not many people left here."
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[5].Dialogue
      value: 'Course there are! Look around! The farm animals are my family. '
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[6].Dialogue
      value: "To me, it\u2019s not worth leaving them behind for some \u201Ceternal
        peace\u201D or whatever that erroneous priest was blabbering about."
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[7].Dialogue
      value: "It\u2019s not that Ion want it. Peace is right here, with these here
        cows."
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[8].Dialogue
      value: "Just look at em eating away at the grass. Ain\u2019t it peaceful? I
        wouldn\u2019t leave em for the world."
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[9].Dialogue
      value: "I mean, Mollis here wouldn\u2019t last a day without me!"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[10].Dialogue
      value: Moo!
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[11].Dialogue
      value: I know sweetie..
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[12].Dialogue
      value: "um.. what does erroneous\u2026 mean?"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[13].Dialogue
      value: 'Haha! Fancy words for a farmer, huh? '
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[14].Dialogue
      value: "It just means that the bullcrap that priest was yapping about is wrong.
        At least that\u2019s what I\u2019ve always thought."
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[15].Dialogue
      value: "it never\u2026 felt right to me, yaknow? Leavin it all behind. all
        these poor animals."
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[16].Dialogue
      value: "I haven\u2019t seen a priest around since I\u2019ve been here"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[17].Dialogue
      value: "I ain\u2019t seen him in a while either. I think he\u2019s just withering
        away in his tower at this point."
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[18].Dialogue
      value: Well, not my business! I got my Mollis here to take care of.
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[3].Choices.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[6].Choices.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[11].Choices.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[15].Choices.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[18].Choices.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[6].Choices.Array.data[0].ChoiceText
      value: "You don\u2019t want eternal peace?"
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[6].Choices.Array.data[1].ChoiceText
      value: Erroneous priest?
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
      propertyPath: DialogueSegments.Array.data[6].Choices.Array.data[2].ChoiceText
      value: Goodbye.
      objectReference: {fileID: 0}
    - target: {fileID: 6124249128449942710, guid: daf638eb82a5c614ea09d127254cb810, type: 3}
